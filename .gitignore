# Godot
.godot/
.import/
export.cfg
*.translation

# export_presets.cfg is intentionally NOT ignored: it is the build definition.
# There are no signing keys or passwords in it, and losing it makes the build
# unreproducible.

# Engine binary (not part of the repo)
tools/godot/
tools/*.exe

# Godot Mono / C# (unused, but harmless to guard)
.mono/
data_*/
mono_crash.*.json

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Build output
build/
dist/
*.tmp

.vercel
